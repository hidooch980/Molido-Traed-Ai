[Unit]
Description=Check the disk before each day's work

[Timer]
# 02:30 UTC, after the nightly backup at 03:15 Tehran writes its dump and
# before the daily digest reads the day. Hourly would be noise: the cache
# only grows when somebody builds.
OnCalendar=*-*-* 02:30:00 UTC
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
