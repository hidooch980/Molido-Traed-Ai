[Unit]
Description=Look for a deploy requested from Telegram every minute

[Timer]
OnBootSec=3min
# OnUnitActiveSec counts from the service's last run, so on its own it never
# fires when the timer is installed after boot: the service has never run.
# OnActiveSec counts from the timer's own start and gives it that first run.
OnActiveSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
