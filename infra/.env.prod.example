# Copy to infra/.env.prod on the server and fill in. Never commit the filled file.
#
# Generate the password with something that is not a word:
#   openssl rand -base64 32

DOMAIN=molidotrade.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=molido
POSTGRES_PASSWORD=CHANGE_ME_USE_openssl_rand
POSTGRES_DB=molidotrade

MOLIDO_LOG_LEVEL=INFO
MOLIDO_MIN_QUALITY_SCORE=0.80

# --------------------------------------------------------------- collector
# Which adapter gathers data. `yfinance` needs no key and is fine for building
# history; it is NOT a production execution feed and its trust weight reflects
# that.
MOLIDO_COLLECTOR_PROVIDER=yfinance

# Seconds between sweeps. 900 = every 15 minutes. Going much below this on a
# free endpoint invites rate limiting, and a rate-limited feed looks exactly
# like a quiet market.
MOLIDO_COLLECTOR_INTERVAL_SECONDS=900

# <canonical>:<provider symbol>:<timeframe>, comma-separated.
# The provider symbol cannot be guessed — Yahoo calls EUR/USD `EURUSD=X` and
# gold `GC=F`. A wrong mapping collects the wrong instrument under a name that
# looks right, which is the most expensive kind of data error.
# At least 20 instruments must share a timeframe or the cross-section refuses
# to rank them, and the deployment collects bars forever without learning from
# any of them. The 27 currency pairs below clear that floor on one session;
# the rest add depth. Shortening this list below 20 turns learning off.
MOLIDO_WATCHLIST=EURUSD:EURUSD=X:H1,GBPUSD:GBPUSD=X:H1,USDJPY:USDJPY=X:H1,USDCHF:USDCHF=X:H1,AUDUSD:AUDUSD=X:H1,USDCAD:USDCAD=X:H1,NZDUSD:NZDUSD=X:H1,EURGBP:EURGBP=X:H1,EURJPY:EURJPY=X:H1,GBPJPY:GBPJPY=X:H1,AUDJPY:AUDJPY=X:H1,CHFJPY:CHFJPY=X:H1,CADJPY:CADJPY=X:H1,NZDJPY:NZDJPY=X:H1,EURAUD:EURAUD=X:H1,EURCHF:EURCHF=X:H1,EURCAD:EURCAD=X:H1,EURNZD:EURNZD=X:H1,GBPAUD:GBPAUD=X:H1,GBPCAD:GBPCAD=X:H1,GBPCHF:GBPCHF=X:H1,AUDCAD:AUDCAD=X:H1,AUDCHF:AUDCHF=X:H1,AUDNZD:AUDNZD=X:H1,NZDCAD:NZDCAD=X:H1,NZDCHF:NZDCHF=X:H1,CADCHF:CADCHF=X:H1,XAUUSD:GC=F:H1,XAGUSD:SI=F:H1,XPTUSD:PL=F:H1,USOIL:CL=F:H1,UKOIL:BZ=F:H1,NGAS:NG=F:H1,COPPER:HG=F:H1,US500:ES=F:H1,US100:NQ=F:H1,US30:YM=F:H1,US2000:RTY=F:H1,BTCUSD:BTC-USD:H1,ETHUSD:ETH-USD:H1,SOLUSD:SOL-USD:H1,XRPUSD:XRP-USD:H1

# ----------------------------------------------------------------- analyst
# The second brain's language half. Empty means no analyst - the decision
# endpoint keeps working and says the analysis is unavailable, which is
# different from an analyst with nothing to say.
#
# Nothing in the trading path reads this. The analyst explains decisions and
# argues with them; no path exists from its output to an order.
MOLIDO_ANTHROPIC_API_KEY=

# Whether the API refuses a caller with no credential.
#
# On, and it should stay on. An anonymous caller holds READ, so with this off
# every instrument, bar, journal entry, risk limit and account figure is
# readable by anybody who knows the path - while the pages above them redirect
# politely to a login screen. Gating the pages is the cheaper half of that pair
# and for a while it was the only half.
#
# The seven routes that exist to *obtain* a credential stay reachable; without
# that exemption a deployment with this on and nobody signed in could never be
# signed into again.
MOLIDO_REQUIRE_AUTH=true
