# Copy to infra/.env for docker compose, and to backend/.env for the app.
# Never commit real secrets.

POSTGRES_USER=molido
POSTGRES_PASSWORD=molido
POSTGRES_DB=molidotrade
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend
MOLIDO_ENV=development
MOLIDO_DATABASE_URL=postgresql+psycopg://molido:molido@localhost:5432/molidotrade
MOLIDO_REDIS_URL=redis://localhost:6379/0
MOLIDO_LOG_LEVEL=INFO
MOLIDO_LOG_JSON=false

# Data quality gate: datasets scoring below this are excluded from training reads
MOLIDO_MIN_QUALITY_SCORE=0.80

# Point-in-time: reject as_of timestamps further in the past than this (days, 0 = no limit)
MOLIDO_MAX_ASOF_AGE_DAYS=0
