# How this site is served, and how it is certified.
#
# Both are parameters rather than fixed text, because they are facts about the
# network in front of this machine rather than preferences. A deployment whose
# DNS points straight here wants its own Let's Encrypt certificate. One behind
# a CDN that terminates TLS itself may never be able to complete an ACME
# challenge - and a certificate that cannot renew is a site that goes dark
# sixty days after somebody stopped watching.
#
#   SITE_ADDRESS  the host, optionally prefixed http:// to serve plain HTTP
#                 (a CDN in front terminating TLS, reaching this origin
#                 unencrypted). Defaults to DOMAIN, which means HTTPS.
#   CADDY_TLS     empty for a real certificate; `tls internal` for a
#                 self-signed one, which is what an origin behind a CDN set to
#                 "full" wants. Empty substitutes to an empty line, which is
#                 not a directive.
#
# `infra/provision.sh` sets both. The API is exposed under /api and /health
# only, and that surface stays exactly this small.

{
	email {$ACME_EMAIL}

	# The site is reached through ArvanCloud's CDN, so every request arrives
	# from a CDN edge. Without this Caddy discards the X-Forwarded-For the CDN
	# sends and writes the edge address in its place; with the API trusting no
	# hops either, all 41 recorded sign-in attempts on 14 September 2026 carried
	# Caddy's own container address - one shared bucket, where fifteen wrong
	# passwords from anyone locked sign-in for everyone for an hour.
	#
	# Only ArvanCloud's published ranges are trusted
	# (https://www.arvancloud.ir/fa/ips.txt, read 14 September 2026). A request
	# that reaches this origin directly, bypassing the CDN, is not trusted and
	# cannot supply its own client address. Paired with
	# MOLIDO_TRUSTED_PROXY_HOPS=2 on the API: the client, then the CDN edge.
	# When ArvanCloud adds ranges, add them here - an untrusted new edge falls
	# back to the edge address, the safe direction.
	servers {
		trusted_proxies static 185.143.232.0/22 188.229.116.16/30 94.101.182.0/27 2.144.3.128/28 37.32.16.0/27 37.32.17.0/27 37.32.18.0/27 37.32.19.0/27 185.215.232.0/22 178.131.120.48/28 94.101.183.0/28 78.157.36.112/28 95.38.61.80/28 193.24.119.0/29
	}
}

{$SITE_ADDRESS} {
	{$CADDY_TLS}

	encode zstd gzip

	# Access logging to stderr, which docker-compose already rotates
	# (json-file, 10m x 5). Without this Caddy records only its own lifecycle,
	# so "has any request reached the origin at all?" - the first question
	# asked of a site returning 503 through the CDN - has no answer here. On
	# 22 September 2026 that question was answered with
	# `grep -c handled_request`, which returned 0 on a perfectly healthy
	# origin serving 200s, and the outage was diagnosed from the wrong fact
	# for a day. A file output is deliberately not used: this host runs at 80%
	# disk, and an unrotated access log is how the remaining 20% disappears.
	log {
		output stderr
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing here uses a camera, a microphone or a location, so nothing
		# here should be able to ask for one - including anything that ends up
		# embedded on a page later without this being reconsidered.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /health/* {
		reverse_proxy api:8000
	}

	# Interactive API docs are useful on a private deployment and a free map of
	# the surface on a public one. Uncomment only if this host is restricted.
	# handle /docs* {
	# 	reverse_proxy api:8000
	# }

	handle {
		reverse_proxy web:3000
	}
}
