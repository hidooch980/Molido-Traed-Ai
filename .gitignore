# Secrets
.env
*.env
!*.env.example
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node
node_modules/
# Next.js local overrides. `.env` and `*.env` do not match `.env.local`, so it
# was one `git add -A` away from committing whichever API a developer happened
# to be pointing at - including a production one.
.env*.local
.next/
out/
npm-debug.log*
# TypeScript's incremental build cache. Tracked until now, so every
# `npm run typecheck` produced a diff nobody meant to commit.
*.tsbuildinfo

# Data / artifacts
data/raw/
data/cache/
*.parquet
*.sqlite3
logs/

# Third-party skills installed from nextlevelbuilder/ui-ux-pro-max-skill.
# Vendored tooling, not project code — 8MB of someone else's files would
# dominate the diff of every clone. Reinstall with:
#   git clone --depth 1 https://github.com/nextlevelbuilder/ui-ux-pro-max-skill
#   cp -r ui-ux-pro-max-skill/.claude/skills/* .claude/skills/
.claude/skills/
